# Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore and must never be committed.

# Supabase Postgres connection string.
# Find it in Supabase: Project Settings > Database > Connection string.
# Leave this line out entirely to run against the local SQLite file instead.
#
# Direct connection (IPv6 networks):
#   DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# Session pooler (works on IPv4, use this one if the direct host is unreachable):
#   DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Port the CRM listens on. Defaults to 4000.
PORT=4000
